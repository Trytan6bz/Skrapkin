# Copy to .env and edit:  cp .env.example .env
# Use letters and digits only, so the connection string needs no URL-encoding.
# Generate one with:  openssl rand -hex 16
MONGO_PASSWORD=change-me

# Optional
# MONGO_USER=skrapkin
# MONGO_PORT=27017
# WEB_PORT=8080
# HUNTER_API_KEY=your-hunter-key

# Sharing with a team: add a password for the web interface, and list the hostname people will use.
# Only change the port mapping in docker-compose.yml if you also set a password.
# SKRAPKIN_WEB_PASSWORD=choose-a-long-passphrase
# SKRAPKIN_ALLOWED_HOSTS=leads.mycompany.com
